import core
import guardrails
import llm

flow main
  activate llm continuation

flow input rails $input_text
  $blocked = await MedicationSafetyCheckAction(text=$input_text)
  if $blocked
    bot say "这个涉及具体的用药剂量，我不能替您决定增加、减少或停止服药。请先按照医生给您的处方或药品说明来服用，如果不确定，最好联系医生或药师确认。"
  # Python owns subsequent semantic processing on both branches.
  abort
