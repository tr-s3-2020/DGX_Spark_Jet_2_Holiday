  "components": {
    "schemas": {
      "BuildContextHTTP": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "title": "Query",
            "default": ""
          },
          "limit": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 8
          },
          "max_chars": {
            "type": "integer",
            "maximum": 3000.0,
            "minimum": 200.0,
            "title": "Max Chars",
            "default": 3000
          },
          "context_locale": {
            "type": "string",
            "maxLength": 64,
            "title": "Context Locale",
            "default": "original"
          },
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "conversation",
              "family_digest"
            ],
            "title": "Purpose"
          },
          "deadline_ms": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 10.0,
            "title": "Deadline Ms",
            "default": 100
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "purpose"
        ],
        "title": "BuildContextHTTP"
      },
      "CloseSessionHTTP": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "expected_session_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Session Version"
          },
          "reason": {
            "type": "string",
            "enum": [
              "completed",
              "user_stopped",
              "disconnected"
            ],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_session_version",
          "reason"
        ],
        "title": "CloseSessionHTTP"
      },
      "Conditions": {
        "properties": {
          "noise": {
            "type": "string",
            "enum": [
              "quiet",
              "noisy",
              "unknown"
            ],
            "title": "Noise",
            "default": "unknown"
          },
          "communication_mode": {
            "type": "string",
            "enum": [
              "voice",
              "text"
            ],
            "title": "Communication Mode",
            "default": "text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Conditions"
      },
      "ContextOptions": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "title": "Query",
            "default": ""
          },
          "limit": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 8
          },
          "max_chars": {
            "type": "integer",
            "maximum": 3000.0,
            "minimum": 200.0,
            "title": "Max Chars",
            "default": 3000
          },
          "context_locale": {
            "type": "string",
            "maxLength": 64,
            "title": "Context Locale",
            "default": "original"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ContextOptions"
      },
      "Controls": {
        "properties": {
          "stop_session": {
            "type": "boolean",
            "title": "Stop Session",
            "default": false
          },
          "skip_topic": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Skip Topic"
          },
          "do_not_persist": {
            "type": "boolean",
            "title": "Do Not Persist",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Controls"
      },
      "Envelope": {
        "properties": {
          "api_version": {
            "type": "string",
            "const": "1.0",
            "title": "Api Version",
            "default": "1.0"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "accepted",
              "ignored",
              "degraded",
              "error"
            ],
            "title": "Status"
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "status",
          "data",
          "error",
          "meta"
        ],
        "title": "Envelope"
      },
      "ForgetEntriesHTTP": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "scope": {
            "type": "string",
            "enum": [
              "entries",
              "session"
            ],
            "title": "Scope"
          },
          "decision_ref": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Decision Ref"
          },
          "entry_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "maxLength": 128,
                  "minLength": 1
                },
                "type": "array",
                "maxItems": 50,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Entry Ids"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
