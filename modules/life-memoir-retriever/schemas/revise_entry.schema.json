{
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "entry_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Entry Id",
      "type": "string"
    },
    "expected_version": {
