    "decision_ref": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Decision Ref",
      "type": "string"
    },
    "content": {
      "anyOf": [
        {
          "maxLength": 16000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content"
    },
    "allowed_uses": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "conversation",
              "family_digest"
