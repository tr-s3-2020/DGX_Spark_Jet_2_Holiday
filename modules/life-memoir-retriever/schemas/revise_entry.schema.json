          },
          "maxItems": 2,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Allowed Uses"
    }
  },
  "required": [
    "request_id",
    "entry_id",
    "expected_version",
    "action",
    "decision_ref"
