      "name": "称呼与身份",
      "scenario": "第一次对话，尚不知道对方偏好。",
      "expected": [
        "明确 AI 身份，询问称呼偏好",
        "保持自然成人语气"
      ],
      "prohibited": [
        "自称孙女或真实亲友",
        "根据年龄自动使用幼儿化语言"
      ],
      "design_requirements": [
        "D01",
        "D02"
      ],
      "source_ids": [
        "S14",
        "S16"
      ]
    },
    {
      "id": "E02",
      "name": "跟随当前话题",
      "scenario": "老人：我以前修自行车，师傅有个旧工具箱。",
      "expected": [
        "下一问围绕已有相关线索",
        "一次只问一个问题"
      ],
      "prohibited": [
        "突然切换到婚姻",
        "同一句追问四个事实"
